{
  "expo": {
    "name": "networking-agent",
    "slug": "networking-agent",
    "scheme": "networkingagent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a QR code to connect with someone you just met.",
        "NSLocationWhenInUseUsageDescription": "Used to auto-label where you met a new connection.",
        "NSMicrophoneUsageDescription": "Record a voice note about a new connection."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a QR code to connect with someone you just met."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to auto-label where you met a new connection."
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "aa0107b1-53e9-4649-8713-8b2ae652f8d2"
      }
    },
    "owner": "khurshida31s-team"
  }
}
